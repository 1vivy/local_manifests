<?xml version="1.0" encoding="UTF-8"?>
<!--
  Feature-gap composition for the OnePlus 15 (infiniti).

  SELF-CONTAINED. Use this file INSTEAD OF 1vivy-infiniti-base.xml, never
  alongside it: repo loads .repo/local_manifests/*.xml in sorted filename order,
  so "1vivy-feature-gaps.xml" is parsed BEFORE "1vivy-infiniti-base.xml" and an
  overlay could not have overridden the base's pins. Dropping both also declares
  device/oneplus/infiniti twice, which repo rejects as a duplicate path.

  The five projects carrying feature-gap work are pinned at the integration
  branch staging/feature-gaps/all; everything else matches 1vivy-infiniti-base.xml.

  staging/feature-gaps/all is the linear integration of thirteen topics, gated by
  `rom-topic verify` and .omo/evidence/icp-simple/04-feature-gaps-gates.sh. Every
  commit carries Icp-Layer / Icp-Class / Upstream-Half trailers so a sibling org
  can cherry-pick the complementary half.

  proprietary_vendor_oneplus_infiniti is served from infiniti-camera-port rather
  than 1vivy: publishing that branch to 1vivy requires 189 Git LFS objects
  (1.84 GiB at HEAD plus history) against GitHub's 1 GiB free per-account quota,
  while infiniti-camera-port already holds every one of them
  (a git lfs push dry run reports 0 objects to upload).
-->
<manifest>
  <!-- Apply patches/patch only after syncing these immutable upstream bases. -->
  <extend-project name="crdroidandroid/android_frameworks_base" revision="7581a03c73562497469d330db893ac2baa361129" />
  <extend-project name="crdroidandroid/android_frameworks_native" revision="da1214c0a2625e98782acec189033c2974614fe4" />
  <extend-project name="crdroidandroid/android_frameworks_av" revision="2598b568888069f73551f4502181eccb21066215" />
  <extend-project name="crdroidandroid/android_device_qcom_sepolicy_vndr" revision="cad392c077ec072059805bac1b1725ad5175790a" />
  <extend-project name="crdroidandroid/android_packages_apps_Sandbox" revision="067327711ce3a1519edb9b263d3f7dc09e2da6e7" />

  <!-- FEATURE-GAP: hardware/oplus carries folio-daemon, radio-modernization and
       the LTPO/VRR work, so it moves off the crDroid pin onto the topic. -->
  <remove-project name="crdroidandroid/android_hardware_oplus" optional="true" />
  <remove-project name="OnePlus-SM8850-Development/android_hardware_oplus" optional="true" />
  <project path="hardware/oplus" name="1vivy/android_hardware_oplus" remote="github" revision="staging/feature-gaps/all" />

  <!-- FEATURE-GAP device trees. -->
  <remove-project name="OnePlus-SM8850-Development/android_device_oneplus_infiniti" optional="true" />
  <remove-project name="crdroidandroid/android_device_oneplus_infiniti" optional="true" />
  <project path="device/oneplus/infiniti" name="1vivy/android_device_oneplus_infiniti" remote="github" revision="staging/feature-gaps/all" />

  <remove-project name="OnePlus-SM8850-Development/android_device_oneplus_sm8850-common" optional="true" />
  <remove-project name="crDroid-OnePlus-SM8850/android_device_oneplus_sm8850-common" optional="true" />
  <project path="device/oneplus/sm8850-common" name="1vivy/android_device_oneplus_sm8850-common" remote="github" revision="staging/feature-gaps/all" />

  <!-- Sibling device lanes stay at their base pins; no feature-gap work targets them. -->
  <remove-project name="OnePlus-SM8850-Development/android_device_oneplus_macan" optional="true" />
  <remove-project name="crdroidandroid/android_device_oneplus_macan" optional="true" />
  <project path="device/oneplus/macan" name="1vivy/android_device_oneplus_macan" remote="github" revision="76c49481da937e12dc38b01f82c7a317ac565365" />

  <remove-project name="OnePlus-SM8850-Development/android_device_oneplus_macanc" optional="true" />
  <remove-project name="crdroidandroid/android_device_oneplus_macanc" optional="true" />
  <project path="device/oneplus/macanc" name="1vivy/android_device_oneplus_macanc" remote="github" revision="133b3eccfd07f5c1d1e4fd2958dc93372bd16076" />

  <remove-project name="OnePlus-SM8850-Development/android_device_oneplus_fairlady" optional="true" />
  <remove-project name="crdroidandroid/android_device_oneplus_fairlady" optional="true" />
  <project path="device/oneplus/fairlady" name="1vivy/android_device_oneplus_fairlady" remote="github" revision="de121f920ddc9ee15f6ba290dde51edf1cd03ef9" />

  <!-- FEATURE-GAP blob repos. -->
  <project path="vendor/oneplus/sm8850-common" name="1vivy/proprietary_vendor_oneplus_sm8850-common" remote="github" revision="staging/feature-gaps/all" />
  <project path="vendor/oneplus/infiniti" name="infiniti-camera-port/proprietary_vendor_oneplus_infiniti" remote="github" revision="staging/feature-gaps/all" />

  <!-- Pure sync inputs: these are never patch targets. -->
  <project path="vendor/oneplus/camera-sm8850-common" name="infiniti-camera-port/vendor_oneplus_camera-sm8850-common" remote="github" revision="16.0-infiniti" />
  <project path="vendor/oneplus/camera-infiniti" name="infiniti-camera-port/vendor_oneplus_camera-infiniti" remote="github" revision="16.0" />
  <project path="proprietary/vendor/oneplus/camera-sm8850-common" name="infiniti-camera-port/proprietary_vendor_oneplus_camera-sm8850-common" remote="github" revision="16.0-infiniti" />
  <project path="proprietary/vendor/oneplus/camera-infiniti" name="infiniti-camera-port/proprietary_vendor_oneplus_camera-infiniti" remote="github" revision="16.0" />
</manifest>
